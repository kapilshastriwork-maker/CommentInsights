# ============================================================
# Comment → Content Intelligence — environment variables
# Copy this file to .env (gitignored) for local dev, OR paste
# these into Render's dashboard "Environment Variables" UI.
# ============================================================

# --- Required ---

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# LLM provider selector. "nvidia" (default) or "groq".
# Drives which provider powers classifyComments / clusterComments / contentGaps.
LLM_PROVIDER=nvidia

# NVIDIA NIM API key (https://build.nvidia.com)
# Required when LLM_PROVIDER=nvidia (the default).
NVIDIA_API_KEY=

# Groq API key (https://console.groq.com/keys)
# Required only if LLM_PROVIDER=groq. Safe to leave blank otherwise.
GROQ_API_KEY=

# --- Optional (have working defaults) ---

# Override the default LLM model on either provider.
# Defaults: GROQ_MODEL=openai/gpt-oss-120b, NVIDIA_MODEL=openai/gpt-oss-120b
GROQ_MODEL=
NVIDIA_MODEL=

# Backend HTTP port. Defaults to 4000 in dev; Render auto-injects PORT in production.
PORT=4000

# Set to "production" on Render so the server serves the built React app from
# client/dist and uses SPA catch-all routing. Leave unset (or "development") for
# local dev where Vite serves the React app on :5173.
NODE_ENV=production
